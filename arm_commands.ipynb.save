   "source": [
    "############### TEST FUNCTIONS ###############\n",
    "\n",
    "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\n",
    "The roma_tray function will run the RoMa through all\n",
    "the motions required to process a tray.\n",
    "***BE SURE TO MOVE PNP AND LIHA TO THE FAR LEFT BEFORE RUNNING***\n",
    "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\n",
    "async def roma_tray():\n",
    "  await backend.send_command(\"C1\", \"PIA\")\n",
    "  await move_tray(carousel, scanner)\n",
    "  await move_tray(scanner, plate_1)\n",
    "  await move_tray(carousel, scanner)\n",
    "  await move_tray(scanner, plate_2)\n",
    "  await move_tray(carousel, scanner)\n",
    "  await move_tray(scanner, plate_3)\n",
    "  await move_tray(carousel, scanner)\n",
    "  await move_tray(scanner, plate_4)\n",
    "  await move_tray(carousel, scanner)\n",
    "  await move_tray(scanner, plate_5)\n",
    "  await move_tray(carousel, scanner)\n",
    "  await move_tray(scanner, plate_6)\n",
    "  await move_tray(plate_1, sealer)\n",
    "  await move_tray(sealer, carousel)\n",
    "  await move_tray(plate_2, sealer)\n",
    "  await move_tray(sealer, carousel)\n",
    "  await move_tray(plate_3, sealer)\n",
    "  await move_tray(sealer, carousel)\n",
    "  await move_tray(plate_4, sealer)\n",
    "  await move_tray(sealer, carousel)\n",
    "  await move_tray(plate_5, sealer)\n",
    "  await move_tray(sealer, carousel)\n",
    "  await move_tray(plate_6, sealer)\n",
    "  await move_tray(sealer, carousel)\n",
    "  await backend.send_command(\"C1\", \"PAA\", [4500, 450, None, 0, None])\n",
    "\n",
    "async def test_tubes():\n",
    "  await backend.send_command(\"W1\", \"PIA\")\n",
    "  await move_tube(tube_rack[1][1],tiu)\n",
    "  await move_tube(tube_rack[9][15],decapper)\n",
    "  await move_tube(tube_rack[2][2],bucket_rack_1[1][2])\n",
    "  await move_tube(tube_rack[3][3],bucket_rack_4[4][0])\n",
    "  await move_tube(tube_rack[8][14],bucket_rack_1[4][1])\n",
    "  await move_tube(tube_rack[7][13],bucket_rack_2[3][0])\n",
    "  await move_tube(tube_rack[9][0],bucket_rack_3[4][1])\n",
    "  await move_tube(tube_rack[8][1],bucket_rack_4[2][1])\n",
    "  await move_tube(tube_rack[7][2],bucket_rack_2[4][2])\n",
    "  await move_tube(bucket_rack_1[1][2],tube_rack)\n",
    "  await move_tube(bucket_rack_2[3][0],tube_rack)\n",
    "  await move_tube(decapper,tube_rack)\n",
    "  await move_tube(bucket_rack_4[4][0],tube_rack)\n",
    "  await move_tube(bucket_rack_2[4][2],tube_rack)\n",
    "  await move_tube(bucket_rack_1[4][1],tube_rack)\n",
    "  await move_tube(bucket_rack_3[4][1],tube_rack)\n",
    "  await move_tube(tiu,tube_rack)\n",
    "  await move_tube(bucket_rack_4[2][1],tube_rack)"
   ]
  },
  {
   "cell_type": "code",
